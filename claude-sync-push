#!/bin/bash
# Claude Code Conversation Sync - Push
# Syncs conversations from each configured profile dir into the repo and pushes.

set -e

ORIGINAL_DIR="$(pwd)"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load configuration
source "$SCRIPT_DIR/lib-claude-sync.sh"

# Handle --version flag
if [ "$1" = "--version" ] || [ "$1" = "-v" ]; then
    show_version "$SCRIPT_DIR" "claude-sync-push"
    exit 0
fi

load_config "$SCRIPT_DIR"

REPO_DIR="$SCRIPT_DIR/conversations"

echo "=== Claude Code Conversation Sync - Push ==="
echo "Repo: $REPO_DIR"
echo ""

# Validate configuration (also populates SYNC_PROFILES)
if ! validate_config; then
    cd "$ORIGINAL_DIR"
    exit 1
fi

# Check if repo is initialized
if [ ! -d "$REPO_DIR/.git" ]; then
    echo "Error: Conversations repository not initialized."
    echo ""
    echo "Run 'claude-sync-init' first to set up the repository."
    cd "$ORIGINAL_DIR"
    exit 1
fi

cd "$REPO_DIR"

# Check if encrypted repo is locked
if [ -d ".git/git-crypt" ]; then
    if git-crypt status 2>/dev/null | grep -q "not decrypted"; then
        echo "Error: Repository is encrypted but locked."
        echo ""
        echo "Unlock first with: claude-restore-encryption-key"
        echo "Or manually: cd $REPO_DIR && git-crypt unlock ~/.claude-git-crypt.key"
        cd "$ORIGINAL_DIR"
        exit 1
    fi
fi

# Pull latest from remote first
if git remote | grep -q origin 2>/dev/null; then
    echo "Pulling latest from remote..."
    git pull origin "$CLAUDE_SYNC_BRANCH" 2>/dev/null || {
        echo "Note: Could not pull. Continuing with local merge..."
    }
    echo ""
fi

# Sync each profile
for profile in "${SYNC_PROFILES[@]}"; do
    SUBDIR="$(profile_subdir "$profile")"
    DEST="$REPO_DIR/$SUBDIR"

    echo "--- Profile: $profile -> $SUBDIR/ ---"
    mkdir -p "$DEST/projects" "$DEST/file-history" "$DEST/todos"

    if [ -d "$profile/projects" ]; then
        echo "Merging conversations..."
        push_merge_dir "$profile/projects" "$DEST/projects"
    fi

    if [ -d "$profile/file-history" ]; then
        echo "Merging file history..."
        push_merge_dir "$profile/file-history" "$DEST/file-history"
    fi

    if [ -d "$profile/todos" ]; then
        echo "Merging todos..."
        push_merge_dir "$profile/todos" "$DEST/todos"
    fi

    if [ -f "$profile/history.jsonl" ]; then
        echo "Syncing global history..."
        cp "$profile/history.jsonl" "$DEST/history.jsonl"
    fi

    echo ""
done

# Sync each Codex profile (populated by validate_config above).
# Only sessions/, history.jsonl and session_index.jsonl are touched: those are
# the parts that are one-file-per-conversation and merge safely with rsync.
# auth.json, the *.sqlite state/queue/cache files, logs and config.toml are
# deliberately left alone (see CLAUDE.md).
for profile in "${CODEX_SYNC_PROFILES[@]}"; do
    SUBDIR="$(profile_subdir "$profile")"
    DEST="$REPO_DIR/$SUBDIR"

    echo "--- Codex profile: $profile -> $SUBDIR/ ---"
    mkdir -p "$DEST/sessions"

    if [ -d "$profile/sessions" ]; then
        echo "Merging sessions..."
        push_merge_dir "$profile/sessions" "$DEST/sessions"
    fi

    if [ -f "$profile/history.jsonl" ]; then
        echo "Syncing history..."
        cp "$profile/history.jsonl" "$DEST/history.jsonl"
    fi

    if [ -f "$profile/session_index.jsonl" ]; then
        echo "Syncing session index..."
        cp "$profile/session_index.jsonl" "$DEST/session_index.jsonl"
    fi

    echo ""
done

# Sync config (settings, skills, ...). A conflict leaves that tree untouched
# but still lets conversations go through.
CONFIG_RC=0
sync_all_config "$REPO_DIR" push || CONFIG_RC=$?

# Check if there are changes
if [ -z "$(git status --porcelain)" ]; then
    echo "No changes to sync."
    cd "$ORIGINAL_DIR"
    exit "$CONFIG_RC"
fi

echo "Changes detected. Committing..."
git add .

# Use configured commit message template
COMMIT_MSG="${CLAUDE_SYNC_COMMIT_MSG}"
COMMIT_MSG="${COMMIT_MSG//\{date\}/$(date '+%Y-%m-%d')}"
COMMIT_MSG="${COMMIT_MSG//\{time\}/$(date '+%H:%M:%S')}"
COMMIT_MSG="${COMMIT_MSG//\{hostname\}/$(hostname)}"

git commit -m "$COMMIT_MSG"

# Push to remote
if git remote | grep -q origin; then
    echo "Pushing to remote..."
    git push origin "$CLAUDE_SYNC_BRANCH" || {
        echo ""
        echo "Error: Could not push. Changes are committed locally only."
        echo "  Check the git error above (conflicts, file size limits, auth)."
        cd "$ORIGINAL_DIR"
        exit 1
    }
else
    echo ""
    echo "No git remote configured. Run 'claude-config' to set it up."
fi

echo ""
echo "Sync complete!"
[ "$CONFIG_RC" -ne 0 ] && echo "Warning: config had conflicts and was not synced (see above)."

cd "$ORIGINAL_DIR"
exit "$CONFIG_RC"
