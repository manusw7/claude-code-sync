# Claude Code Conversation Sync - Configuration
#
# Copy this file to .claude-sync-config.local and customize for your setup.
# The .local file is gitignored and won't be synced to your repo.
#
# Environment variables (CLAUDE_SYNC_*) will override these settings.

# Git remote URL for syncing conversations
# Examples:
#   CLAUDE_SYNC_REMOTE="git@bitbucket.org:username/claude-sync.git"
#   CLAUDE_SYNC_REMOTE="git@github.com:username/claude-sync.git"
#   CLAUDE_SYNC_REMOTE="https://github.com/username/claude-sync.git"
# Note: Use ${VAR:-value} syntax to allow environment variables to override
CLAUDE_SYNC_REMOTE="${CLAUDE_SYNC_REMOTE:-}"

# Git branch to use (default: main)
CLAUDE_SYNC_BRANCH="${CLAUDE_SYNC_BRANCH:-main}"

# Enable encryption (requires git-crypt)
# Set to "true" to enable, "false" to disable
CLAUDE_SYNC_ENCRYPTION="${CLAUDE_SYNC_ENCRYPTION:-false}"

# Backup retention - how many days to keep backups
CLAUDE_BACKUP_RETENTION_DAYS="${CLAUDE_BACKUP_RETENTION_DAYS:-30}"

# Claude data directory (usually ~/.claude)
# Only change this if you have a non-standard installation
CLAUDE_DATA_DIR="${CLAUDE_DATA_DIR:-$HOME/.claude}"

# Verbose output (true/false)
CLAUDE_SYNC_VERBOSE="${CLAUDE_SYNC_VERBOSE:-false}"

# Auto-commit message template
# Available variables: {date}, {time}, {hostname}
CLAUDE_SYNC_COMMIT_MSG="${CLAUDE_SYNC_COMMIT_MSG:-Sync conversations - {date} {time} - {hostname}}"

# Semicolon-separated list of Claude data dirs to sync, e.g. when you run
# more than one Claude Code profile on the same machine. Each is stored
# under conversations/<basename>/ in the repo. Defaults to CLAUDE_DATA_DIR.
# Example: CLAUDE_SYNC_PROFILES="$HOME/.claude;$HOME/.claude-work"
CLAUDE_SYNC_PROFILES="${CLAUDE_SYNC_PROFILES:-}"

# Codex CLI data directory (usually ~/.codex)
CODEX_DATA_DIR="${CODEX_DATA_DIR:-$HOME/.codex}"

# Semicolon-separated list of Codex data dirs to sync, same idea as
# CLAUDE_SYNC_PROFILES. Leave empty to skip Codex sync entirely - this is
# opt-in, since not everyone using this tool has Codex CLI installed. Only
# sessions/, history.jsonl and session_index.jsonl are synced: auth.json,
# the *.sqlite state/queue/cache files and config.toml are never touched.
# Example: CLAUDE_SYNC_CODEX_PROFILES="$HOME/.codex"
CLAUDE_SYNC_CODEX_PROFILES="${CLAUDE_SYNC_CODEX_PROFILES:-}"
